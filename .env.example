# Copy this file to .env and fill only the provider(s) you plan to use.

# Direct OpenAI model path: gpt-*
OPENAI_API_KEY=

# OpenRouter-compatible path for model names containing '/'.
# Example: google/gemini-2.5-pro
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Direct Anthropic path: claude-*
ANTHROPIC_API_KEY=

# Direct Google Gemini path: gemini-*
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Hugging Face path: hf:<repo-id>
HUGGINGFACEHUB_API_TOKEN=

# Optional Hugging Face endpoint configuration.
HF_ENDPOINT_URL=

# Model names are intentionally configurable while still being constants in app/graph.py.
FAST_TEXT_MODEL=gpt-4o-mini
VISION_MODEL=google/gemini-2.5-pro

# App settings
MAX_IMAGE_SIZE_MB=5
REQUEST_TIMEOUT_SECONDS=45
CORS_ORIGINS=http://localhost:8000
